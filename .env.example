# EthioNet Pulse Configuration

# Application
APP_NAME="EthioNet Pulse"
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/ethionet.db

# Scheduled connectivity monitoring
CHECK_INTERVAL_SECONDS=30
INTERNET_TARGETS=1.1.1.1,8.8.8.8,9.9.9.9
REQUEST_TIMEOUT_SECONDS=5

# On-demand diagnosis
DNS_TEST_HOSTS=example.com,cloudflare.com
# Optional comma-separated business endpoints, e.g. https://example.com,https://your-service.example/health
SERVICE_URLS=

# Alert reliability: require consecutive complete check rounds before
# recording an outage, and consecutive successful rounds before recovery.
OUTAGE_FAILURE_THRESHOLD=2
OUTAGE_RECOVERY_THRESHOLD=2

# Optional Telegram alerts. Keep the bot token private in your local .env.
ENABLE_TELEGRAM_ALERTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
