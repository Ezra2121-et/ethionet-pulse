# EthioNet Pulse Configuration

# Application
APP_NAME="EthioNet Pulse"
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/ethionet.db

# Scheduled connectivity monitoring
CHECK_INTERVAL_SECONDS=30
INTERNET_TARGETS=1.1.1.1,8.8.8.8,9.9.9.9
REQUEST_TIMEOUT_SECONDS=5

# On-demand diagnosis
DNS_TEST_HOSTS=example.com,cloudflare.com
# Comma-separated HTTP(S) endpoints checked continuously and by on-demand diagnosis.
# Use a small health-check URL where possible; do not put secrets in URL query strings.
SERVICE_URLS=https://example.com
SERVICE_REQUEST_TIMEOUT_SECONDS=10
SERVICE_FAILURE_THRESHOLD=2
SERVICE_RECOVERY_THRESHOLD=2

# Multi-packet network quality checks (ICMP).
PING_SAMPLES_PER_CHECK=5
QUALITY_PING_TIMEOUT_SECONDS=1
PACKET_LOSS_WARNING_PERCENT=20.0
HIGH_LATENCY_WARNING_MS=400.0
DEGRADATION_CONSECUTIVE_ROUNDS=3
QUALITY_RECOVERY_CONSECUTIVE_ROUNDS=3

# Alert reliability: require consecutive complete check rounds before
# recording an outage, and consecutive successful rounds before recovery.
OUTAGE_FAILURE_THRESHOLD=2
OUTAGE_RECOVERY_THRESHOLD=2

# Optional Telegram alerts. Keep the bot token private in your local .env.
ENABLE_TELEGRAM_ALERTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
